<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PreferenceSpecifiers</key>
	<array>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Graphics</string>
			<key>FooterText</key>
			<string>30 fps halves the work per second and keeps the phone cooler. Frame rate and MetalFX take effect when you return to the game; render resolution at the next launch, and only in games that support it. MetalFX sharpens the picture when it is scaled up to the screen. iOS always shows frames in step with the display, so there is no V-Sync switch.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Frame rate</string>
			<key>Key</key>
			<string>dm.fps</string>
			<key>DefaultValue</key>
			<integer>60</integer>
			<key>Titles</key>
			<array>
				<string>60 fps</string>
				<string>30 fps</string>
			</array>
			<key>Values</key>
			<array>
				<integer>60</integer>
				<integer>30</integer>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Render resolution</string>
			<key>Key</key>
			<string>dm.render_height</string>
			<key>DefaultValue</key>
			<integer>0</integer>
			<key>Titles</key>
			<array>
				<string>Game default</string>
				<string>900p</string>
				<string>720p</string>
				<string>540p</string>
			</array>
			<key>Values</key>
			<array>
				<integer>0</integer>
				<integer>900</integer>
				<integer>720</integer>
				<integer>540</integer>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>MetalFX upscaling</string>
			<key>Key</key>
			<string>dm.metalfx</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSGroupSpecifier</string>
			<key>Title</key>
			<string>Diagnostics</string>
			<key>FooterText</key>
			<string>Shows the last lines of the app's log over the game. Touches pass through it.</string>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Show log on screen</string>
			<key>Key</key>
			<string>dm.log_overlay</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Only [red] lines</string>
			<key>Key</key>
			<string>dm.log_overlay_red</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSMultiValueSpecifier</string>
			<key>Title</key>
			<string>Lines</string>
			<key>Key</key>
			<string>dm.log_overlay_lines</string>
			<key>DefaultValue</key>
			<integer>14</integer>
			<key>Titles</key>
			<array>
				<string>8</string>
				<string>14</string>
				<string>24</string>
			</array>
			<key>Values</key>
			<array>
				<integer>8</integer>
				<integer>14</integer>
				<integer>24</integer>
			</array>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Log every system call (svc)</string>
			<key>Key</key>
			<string>dm.svc</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
		<dict>
			<key>Type</key>
			<string>PSToggleSwitchSpecifier</string>
			<key>Title</key>
			<string>Log module imports</string>
			<key>Key</key>
			<string>dm.imports</string>
			<key>DefaultValue</key>
			<false/>
		</dict>
	</array>
</dict>
</plist>
