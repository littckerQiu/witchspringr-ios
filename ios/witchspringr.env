# Switches baked into this build's bundle (Gen/dm/env.txt): read at launch, so the phone needs no setup.
# Upstream (seedds/nxnative) measured why WitchSpring R aborts in a global constructor: its StandardAllocator requests
# (pool - images) as one contiguous virtual address region, and with the 3797 MB pool this build used to report that was
# 3.69 GB, leaving too little of the alias region for the pools Unity's TLSF heap asks for -- operator new returned 0 and
# the game wrote through a null pointer (main+0x37d174 after operator new(4) at main+0x2d0990). 2385 MB -> ~2.27 GB heap.
DM_APP_POOL_ADD_MB=-900
DM_SVC=1
