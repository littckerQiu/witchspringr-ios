<!-- Game package (NSP / XCI) → ExeFS and RomFS, with LibHac. Usage in the header of Program.cs; tools/game_extract.sh builds and runs it.
     packages.lock.json pins LibHac by content hash: a restore that would bring other bytes fails. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibHac" Version="[0.19.0]" />
  </ItemGroup>
</Project>
